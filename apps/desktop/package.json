{
  "name": "easyemailam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "npm run core:build && npm run dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:smoke": "node scripts/verify-preview-http.mjs",
    "test:unit": "node --test \"tests/*.test.ts\"",
    "ui:verify": "node scripts/verify-neuroterminal-ui.mjs",
    "tauri": "tauri",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "core:build": "npm --prefix ../../service/base run build",
    "core:bundle": "node scripts/bundle-core-runtime.mjs",
    "core:verify": "node scripts/verify-core-bundle.mjs",
    "portable:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "portable:build": "npm run tauri -- build --ci --no-sign --bundles msi nsis && npm run portable:bundle",
    "host:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-desktop-host-smoke.ps1",
    "host:startup-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-desktop-startup-responsiveness.ps1",
    "verify": "npm run test:unit && npm run ui:verify && npm run build && npm run preview:smoke && npm run rust:fmt && npm run rust:clippy && npm run rust:test && npm run rust:check && npm run core:bundle && npm run core:verify"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
