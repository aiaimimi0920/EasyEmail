    "esbuild": "0.28.2",
    "hono": "4.13.14",
    "miniflare": "5.20261023.1-beta",
    "playwright-core": "1.62.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.9.2",
    "wrangler": "4.154.0"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "entities": "9.0.0",
