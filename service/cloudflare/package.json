  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "release:plan": "node scripts/prepare-release.mjs plan",
    "release:prepare": "node scripts/prepare-release.mjs prepare",
    "release:verify": "node scripts/prepare-release.mjs verify",
    "test:release": "node scripts/run-tests.mjs release",
    "test:portability": "node scripts/run-tests.mjs portability",
    "test:upstream": "node scripts/run-tests.mjs upstream",
