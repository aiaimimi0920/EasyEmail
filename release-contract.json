{
  "schemaVersion": 1,
  "project": "EasyEmail",
  "releaseClass": "multi-surface-service-and-client-distribution",
  "productContract": "product-contract.json",
  "coordinator": {
    "path": ".github/workflows/release-easyemail.yml",
    "targets": [
      "all",
      "service-base",
      "cloudflare-email",
      "client-userscript"
    ],
    "publicTagPatterns": [
      "v*",
      "release-*"
    ],
    "serialOrder": [
      "client-userscript",
      "service-base",
      "cloudflare-email"
    ],
    "requiresReusableValidation": true
  },
  "workflows": [
    {
      "component": "service-base",
      "path": ".github/workflows/publish-service-base-ghcr.yml",
      "releaseTagInputs": [
        "release_tag",
        "version"
      ],
      "releaseTagOutputs": [
        "release_tag",
        "version"
      ],
      "artifacts": [
        "service-base-release-manifest",
        "service-base-r2-config-manifest",
        "service-base-import-code-encrypted"
      ],
      "requiresGhcr": true,
      "requiresR2": true,
      "requiresImportCode": true,
      "requiresGitHubRelease": true,
      "requiresReusableValidation": true,
      "environment": "easyemail-service-production"
    },
    {
      "component": "cloudflare-email",
      "path": ".github/workflows/deploy-cloudflare-email.yml",
      "artifacts": [
        "cloudflare-email-release-manifest",
        "cloudflare-email-deployment-notes",
        "cloudflare-email-runtime-readback"
      ],
      "requiresCloudflareDeploy": true,
      "requiresRuntimeReadback": true,
      "requiresGitHubRelease": true,
      "requiresReusableValidation": true,
      "environment": "easyemail-cloudflare-production"
    },
    {
      "component": "client-userscript",
      "path": ".github/workflows/publish-client-userscript.yml",
      "releaseTagInputs": [
        "release_tag"
      ],
      "releaseTagOutputs": [
        "release_tag",
        "version"
      ],
      "artifacts": [
        "easy-email-client-userscript-distribution",
        "easy-email-client-userscript-release-evidence"
      ],
      "requiresDistributionBuilder": true,
      "requiresReusableValidation": true,
      "requiresAttestation": true,
      "requiresGitHubRelease": true,
      "forbidsProductionSecrets": true,
      "environment": "easyemail-public-release"
    }
  ],
  "requiredFiles": [
    "product-contract.json",
    "docs/easyemail-openapi.json",
    "docs/http-api.md",
    "docs/ui-bundled-runtime.md",
    "clients/typescript/package.json",
    "clients/typescript/src/index.ts",
    "scripts/build-distribution.py",
    "scripts/build-userscript-release.py",
    "scripts/userscript_release.py",
    "docs/release-operations.md"
  ],
  "localDeploy": {
    "entrypoint": "deploy-host.ps1",
    "zeroFolder": true,
    "forbidDevSourceBindMounts": true
  },
  "securityBoundaries": [
    "Published Userscript assets contain tracked placeholders only and never repository or production secrets.",
    "Standalone callers use the documented HTTP API directly; no published SDK is required.",
    "The compatibility TypeScript client is optional and never owns the authoritative API contract.",
    "The bundled UI starts the packaged service/base core and communicates over authenticated loopback HTTP.",
    "The Userscript is an independent direct-provider runtime and never proxies through service/base.",
    "Configured Userscripts remain local operator artifacts and are not uploaded by public release workflows."
  ],
  "exceptions": []
}
